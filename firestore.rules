rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- who is who ----------
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isTeacher() { return signedIn() && exists(/databases/$(db)/documents/teachers/$(request.auth.uid))
      && get(/databases/$(db)/documents/teachers/$(request.auth.uid)).data.get("archived", false) != true; }
    function teachesSection(sec) {
      return isTeacher() && sec in get(/databases/$(db)/documents/teachers/$(request.auth.uid)).data.sections;
    }
    // Approved AND not expired
    function activeStudent() {
      return signedIn()
        && get(/databases/$(db)/documents/students/$(request.auth.uid)).data.status == "active"
        && (!("expiresAt" in get(/databases/$(db)/documents/students/$(request.auth.uid)).data)
            || get(/databases/$(db)/documents/students/$(request.auth.uid)).data.expiresAt > request.time);
    }
    function mySection() { return get(/databases/$(db)/documents/students/$(request.auth.uid)).data.section; }

    // ---------- class sessions (the teacher's Activate button) ----------
    function sessionOpen(id) {
      return exists(/databases/$(db)/documents/sessions/$(id))
        && get(/databases/$(db)/documents/sessions/$(id)).data.status == "open"
        && get(/databases/$(db)/documents/sessions/$(id)).data.closesAt > request.time;
    }
    function canPlay(sec, lvl) {
      let base = sec + "_L" + string(lvl);
      return sessionOpen(base) || sessionOpen(base + "_" + request.auth.uid);
    }

    // ---------- students ----------
    match /students/{uid} {
      // A student can only create their OWN record, pending, with exactly these fields, in a real section
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(["fullname","studentIdNumber","username","section","status","role","createdAt"])
                    && request.resource.data.status == "pending"
                    && request.resource.data.role == "student"
                    && request.resource.data.fullname is string
                    && request.resource.data.fullname.size() >= 2 && request.resource.data.fullname.size() <= 80
                    && request.resource.data.studentIdNumber is string
                    && request.resource.data.studentIdNumber.size() >= 3 && request.resource.data.studentIdNumber.size() <= 20
                    && request.resource.data.section is string
                    && exists(/databases/$(db)/documents/sections/$(request.resource.data.section));
      allow read: if signedIn() && (request.auth.uid == uid || teachesSection(resource.data.section) || isAdmin());
      // Teachers may only change these fields, never the section, and never a student's own ID or role
      allow update: if isAdmin()
                    || (teachesSection(resource.data.section)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","fullname","approvedAt","expiresAt"])
                        && request.resource.data.status in ["pending","active","archived"]);
      allow delete: if teachesSection(resource.data.section) || isAdmin();
    }

    // ---------- progress marker: "this student finished this map" ----------
    // The game writes it, and only while the teacher's session is open. Grades are in /evaluations.
    // The teacher can DELETE it (Reset level) so a student can retake after a technical failure.
    match /scores/{id} {
      allow create: if activeStudent()
                    && request.resource.data.keys().hasOnly(["uid","studentIdNumber","fullname","section","level","destination","createdAt"])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.section == mySection()
                    && request.resource.data.level is int
                    && request.resource.data.level >= 1 && request.resource.data.level <= 3
                    && id == request.auth.uid + "_L" + string(request.resource.data.level)
                    && canPlay(request.resource.data.section, request.resource.data.level);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || teachesSection(resource.data.section) || isAdmin());
      allow delete: if teachesSection(resource.data.section) || isAdmin();
    }

    // ---------- teacher-entered grades ----------
    function validEval(d, id) {
      return d.keys().hasOnly(["uid","studentIdNumber","fullname","section","level","destination","remarks","status",
                               "evaluatorUid","evaluatorName","updatedAt","submittedAt","scores","rubric","total"])
        && d.uid is string && d.section is string
        && d.level is int && d.level >= 1 && d.level <= 3
        && id == d.uid + "_L" + string(d.level)
        && d.status in ["draft","submitted"]
        && d.scores is map && d.scores.size() >= 1 && d.scores.size() <= 10
        && d.rubric is list && d.rubric.size() == d.scores.size()
        && d.total is number && d.total >= 0 && d.total <= 100
        && (!("remarks" in d) || (d.remarks is string && d.remarks.size() <= 200))
        && d.evaluatorUid == request.auth.uid
        // the student must really exist in that section
        && get(/databases/$(db)/documents/students/$(d.uid)).data.section == d.section;
    }
    // A student can read only their own grades, and only after the teacher pressed Submit & release
    match /evaluations/{id} {
      allow read: if signedIn() && ((resource.data.uid == request.auth.uid && resource.data.status == "submitted")
                                    || teachesSection(resource.data.section) || isAdmin());
      allow create, update: if teachesSection(request.resource.data.section) && validEval(request.resource.data, id);
      allow delete: if teachesSection(resource.data.section) || isAdmin();
    }

    // ---------- sessions ----------
    // id = "<section>_L<level>" (whole class) or "<section>_L<level>_<studentUid>" (one student).
    // A session can never be opened for longer than 6 hours.
    function validSession(d, id) {
      return d.keys().hasOnly(["section","level","destination","status","studentUid","opensAt","closesAt","teacherUid","teacherName"])
        && d.section is string && d.level is int && d.level >= 1 && d.level <= 3
        && d.status in ["open","closed"]
        && d.studentUid is string
        && id == d.section + "_L" + string(d.level) + (d.studentUid == "" ? "" : "_" + d.studentUid)
        && d.closesAt is timestamp
        && (d.status == "closed" || d.closesAt <= request.time + duration.value(6, "h"));
    }
    match /sessions/{id} {
      allow read: if signedIn() && (teachesSection(resource.data.section) || isAdmin()
                                    || (activeStudent() && resource.data.section == mySection()));
      allow create: if teachesSection(request.resource.data.section) && validSession(request.resource.data, id)
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update: if teachesSection(request.resource.data.section) && validSession(request.resource.data, id);
      allow delete: if teachesSection(resource.data.section) || isAdmin();
    }

    // ---------- live monitor (what the student is doing right now) ----------
    // The VR app writes ONE small document per student (id = the student's uid). Teachers read their own sections.
    match /live/{uid} {
      allow create, update: if activeStudent() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(["uid","studentIdNumber","fullname","section","scene","level","destination","phase",
                                                             "stopNumber","stopTotal","stopTitle","speaker","question","mapLeft","answerLeft",
                                                             "x","z","yaw","viewUrl","updatedAt"])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.section == mySection()
                    && request.resource.data.phase in ["menu","walking","reading","answering","finished","offline"]
                    && request.resource.data.question.size() <= 600
                    && request.resource.data.viewUrl.size() <= 80;
      allow read: if signedIn() && (teachesSection(resource.data.section) || isAdmin());
      allow delete: if signedIn() && (request.auth.uid == uid || teachesSection(resource.data.section) || isAdmin());
    }

    // ---------- sections (public read: the register screen needs them before login) ----------
    match /sections/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
                    && request.resource.data.keys().hasOnly(["name","capacity"])
                    && request.resource.data.name == id
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
                    && request.resource.data.capacity is int
                    && request.resource.data.capacity >= 1 && request.resource.data.capacity <= 200;
      allow delete: if isAdmin();
    }

    // ---------- grading criteria: a list of {key,label,max}, set by the admin (the maximums add up to 100, checked on the page) ----------
    match /settings/criteria {
      allow read: if signedIn();
      allow create, update: if isAdmin()
                    && request.resource.data.keys().hasOnly(["items"])
                    && request.resource.data.items is list
                    && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 10;
      allow delete: if false;
    }

    // ---------- site settings (name and title shown in the admin header) ----------
    match /settings/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
                    && request.resource.data.keys().hasOnly(["headName","headTitle"])
                    && request.resource.data.headName is string && request.resource.data.headName.size() >= 2 && request.resource.data.headName.size() <= 80
                    && request.resource.data.headTitle is string && request.resource.data.headTitle.size() >= 2 && request.resource.data.headTitle.size() <= 100;
      allow delete: if false;
    }

    // ---------- teachers and admins ----------
    match /teachers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Employee ID must be exactly 10 digits (older teacher records are allowed to keep theirs until re-created)
      allow create, update: if isAdmin()
                    && request.resource.data.keys().hasOnly(["name","employeeId","email","sections","archived"])
                    && (request.resource.data.employeeId.matches("^[0-9]{10}$")
                        || (resource != null && request.resource.data.employeeId == resource.data.employeeId))
                    && request.resource.data.name is string && request.resource.data.name.size() >= 2
                    && request.resource.data.sections is list && request.resource.data.sections.size() <= 30
                    && (!("archived" in request.resource.data) || request.resource.data.archived is bool);
      allow delete: if false;          // teachers are archived, never deleted
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;           // create admins by hand in the Console
    }

    // ---------- "Student ID / Employee ID -> login email" (needed BEFORE login, so one document can be read by anyone) ----------
    // Only the owner of that email can create it. Nobody can list the whole collection.
    match /loginIds/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && id.matches("^[0-9]{10}$")
                    && request.resource.data.keys().hasOnly(["email"])
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && (resource == null || resource.data.email == request.auth.token.email)
                    || isAdmin() && id.matches("^[0-9]{10}$") && request.resource.data.keys().hasOnly(["email"]);
      allow delete: if isAdmin();
    }

    // ---------- questions ----------
    // Original questions: only the admin can change them.
    // Added questions (isExtra): an instructor can add, edit and delete ONLY their own, and only for the sections they handle.
    // The admin can add for all sections or chosen sections, and can manage every added question.
    // To stop outsiders from reading the questions, change "read: if true" to "read: if signedIn()"
    // (only after you confirm the VR app loads questions AFTER the student logs in).
    function myTeacherSections() { return get(/databases/$(db)/documents/teachers/$(request.auth.uid)).data.sections; }
    function goodQuestion(d) {
      return d.questionText is string && d.questionText.size() >= 3 && d.questionText.size() <= 400
          && (!("keyPoints" in d) || (d.keyPoints is string && d.keyPoints.size() <= 800))
          && (!("speakerNPC" in d) || (d.speakerNPC is string && d.speakerNPC.size() <= 60));
    }
    function mySectionsOnly(d) {
      return d.sections is list && d.sections.size() >= 1 && d.sections.size() <= 30
          && d.sections.hasOnly(myTeacherSections());
    }
    match /Scenarios_tbl/{id} {
      allow read: if true;
      allow create: if isAdmin()
                    || (isTeacher() && request.resource.data.isExtra == true
                        && request.resource.data.createdBy == request.auth.uid
                        && request.resource.data.destinationID is string
                        && goodQuestion(request.resource.data)
                        && mySectionsOnly(request.resource.data));
      allow update: if isAdmin()
                    || (isTeacher() && resource.data.isExtra == true && resource.data.createdBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["speakerNPC","questionText","keyPoints","sections"])
                        && goodQuestion(request.resource.data)
                        && mySectionsOnly(request.resource.data));
      allow delete: if isAdmin() || (isTeacher() && resource.data.isExtra == true && resource.data.createdBy == request.auth.uid);
    }

    // ---------- the questions each student was asked (saved by the game, shown in Scores) ----------
    // id = "<studentUid>_L<level>". q = { "1": {stop, speaker, text}, "2": ... } (one entry per question of the map)
    match /asked/{id} {
      allow create, update: if activeStudent()
                    && request.resource.data.keys().hasOnly(["uid","studentIdNumber","fullname","section","level","destination","q","updatedAt"])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.section == mySection()
                    && request.resource.data.level is int
                    && request.resource.data.level >= 1 && request.resource.data.level <= 3
                    && id == request.auth.uid + "_L" + string(request.resource.data.level)
                    && request.resource.data.q is map && request.resource.data.q.size() <= 12;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || teachesSection(resource.data.section) || isAdmin());
      allow delete: if teachesSection(resource.data.section) || isAdmin();
    }

    // Reserve waypoint limit per destination
    match /levels/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
                    && request.resource.data.extraWaypoints is int
                    && request.resource.data.extraWaypoints >= 0 && request.resource.data.extraWaypoints <= 3;
      allow delete: if isAdmin();
    }

    // Training modules: an instructor changes ONLY their own, and only for the sections they handle.
    // (Older modules without "sections" reach every section.) The admin can manage all of them.
    function goodModule(d) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 120
          && d.content is string && d.content.size() <= 5000
          && d.link is string
          && (d.link == "" || d.link.matches("https?://.*"));
    }
    match /modules/{id} {
      allow read: if true;
      allow create: if (isAdmin() && goodModule(request.resource.data))
                    || (isTeacher() && goodModule(request.resource.data)
                        && request.resource.data.createdBy == request.auth.uid
                        && mySectionsOnly(request.resource.data));
      allow update: if (isAdmin() && goodModule(request.resource.data))
                    || (isTeacher() && goodModule(request.resource.data)
                        && resource.data.get("createdBy", "") == request.auth.uid
                        && request.resource.data.createdBy == request.auth.uid
                        && mySectionsOnly(request.resource.data));
      allow delete: if isAdmin() || (isTeacher() && resource.data.get("createdBy", "") == request.auth.uid);
    }
  }
}
